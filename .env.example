# Copy this file to .env and fill in real secrets before running
# `docker compose up`. Never commit the real .env file.

# --- Platform metadata database (Postgres) ---
POSTGRES_DB=frappe_platform
POSTGRES_USER=frappe_platform
POSTGRES_PASSWORD=change-me-postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma separated list of hostnames the Django app itself will answer on.
DJANGO_ALLOWED_HOSTS=platform.localhost,localhost,127.0.0.1

# Space separated (nginx server_name syntax, unlike the comma separated
# lists above) list of hostnames nginx's platform UI/API server block
# answers on. Anything not matching a site's own server block (see
# api/sites/nginx_config.py) falls through to this one. Substituted into
# proxy/nginx.conf at container boot — see proxy/Dockerfile.
PLATFORM_DOMAINS=platform.localhost localhost

# --- Seeded platform admin user (created on first boot only) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- MariaDB shared by every bench ---
MARIADB_ROOT_PASSWORD=change-me-mariadb-root

# --- Bench containers ---
# Image tag the platform builds locally and uses when creating new bench
# containers on demand (see bench_image/Dockerfile).
BENCH_IMAGE_TAG=frappe-platform/bench:latest
# Docker network every platform + bench-unit container joins, declared in
# docker-compose.yml.
DOCKER_NETWORK_NAME=frappe-platform-net

# --- Site hostname whitelist ---
# Comma separated list of domains a site's hostname must be exactly or a
# subdomain of. nginx itself will route any hostname it's given, so this
# is the actual gate against creating a site under a domain the operator
# doesn't control. Add a real domain here once it's ready to host a site,
# e.g. ALLOWED_SITE_DOMAINS=localhost,kartoza.com
ALLOWED_SITE_DOMAINS=localhost

# --- SSL (Let's Encrypt via certbot) ---
# Off by default — only turn on once a real domain above has DNS
# actually pointed at this host (port 80 reachable from the internet).
# Never turns on for "localhost" sites; see SSL_EXCLUDED_DOMAINS in
# settings.py. Auto-renews daily via Celery beat (see platform_api/celery.py).
SSL_ENABLED=0
# Use Let's Encrypt's staging API (untrusted certs, near-unlimited rate
# limit) while testing this feature itself, to avoid burning the
# production API's much stricter limits on mistakes.
SSL_STAGING=0
# Contact email Let's Encrypt uses for expiry/problem notices. Defaults
# to ADMIN_EMAIL above if left unset.
#SSL_CONTACT_EMAIL=

# --- Email (optional — invite links work without this, see accounts/tasks.py) ---
# Leave EMAIL_HOST unset to just log invite emails to the worker's console.
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=1
#DEFAULT_FROM_EMAIL=noreply@yourdomain.com
