# Copy this file to .env and fill in real secrets before running
# `docker compose up`. Never commit the real .env file.

# --- Platform metadata database (Postgres) ---
POSTGRES_DB=frappe_platform
POSTGRES_USER=frappe_platform
POSTGRES_PASSWORD=change-me-postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma separated list of hostnames the Django app itself will answer on.
DJANGO_ALLOWED_HOSTS=platform.localhost,localhost,127.0.0.1

# --- Seeded platform admin user (created on first boot only) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- MariaDB shared by every bench ---
MARIADB_ROOT_PASSWORD=change-me-mariadb-root

# --- Bench containers ---
# Image tag the platform builds locally and uses when creating new bench
# containers on demand (see bench_image/Dockerfile).
BENCH_IMAGE_TAG=frappe-platform/bench:latest
# Docker network every platform + bench-unit container joins, declared in
# docker-compose.yml.
DOCKER_NETWORK_NAME=frappe-platform-net

# --- Email (optional — invite links work without this, see accounts/tasks.py) ---
# Leave EMAIL_HOST unset to just log invite emails to the worker's console.
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=1
#DEFAULT_FROM_EMAIL=noreply@yourdomain.com
